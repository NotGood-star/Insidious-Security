datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GuildConfig {
  guildId               String   @id
  antiRaidEnabled       Boolean  @default(false)
  antiRaidThreshold     Int      @default(10)
  antiSpamEnabled       Boolean  @default(true)
  antiLinkEnabled       Boolean  @default(false)
  verificationChannelId String?
  securityChannelId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Whitelist {
  id        String   @id @default(uuid())
  guildId   String
  targetId  String
  type      String   // "USER" or "ROLE"
  createdAt DateTime @default(now())

  @@unique([guildId, targetId])
}

model SecurityLog {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  action    String   // "KICK", "BAN", "TIMEOUT", "WARN"
  reason    String
  createdAt DateTime @default(now())
}
